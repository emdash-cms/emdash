{
	"name": "@emdash-cms/release-action",
	"version": "0.0.1",
	"private": true,
	"description": "GitHub Action for delegated EmDash plugin releases.",
	"type": "module",
	"scripts": {
		"build": "tsdown && node scripts/normalize-dist.mjs && node scripts/check-dist.mjs",
		"test": "vitest run",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@atcute/lexicons": "catalog:",
		"@emdash-cms/registry-client": "workspace:*",
		"@emdash-cms/registry-lexicons": "workspace:*",
		"@emdash-cms/registry-verification": "workspace:*",
		"image-size": "catalog:",
		"jsonc-parser": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
