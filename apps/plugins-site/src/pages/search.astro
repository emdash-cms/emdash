---
import PluginCard from "../components/PluginCard.astro";
import SearchHead from "../components/search/SearchHead.astro";
import SearchPagination from "../components/search/SearchPagination.astro";
import StatePanel from "../components/StatePanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchCatalog, withLatestReleases } from "../lib/catalog.js";
import {
	isRegistryRequestRejected,
	REGISTRY_PAGE_CACHE,
} from "../lib/registry.js";
import {
	PAGE_SIZE,
	parsePage,
	refineKeywords,
	resultSummary,
	searchHref,
} from "../lib/search.js";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedPage = parsePage(Astro.url.searchParams.get("page"));

const result = await searchCatalog(query);
const hasError =
	"error" in result && !(query && isRegistryRequestRejected(result.error));
const packages = "packages" in result ? result.packages : [];
const pageCount = Math.max(1, Math.ceil(packages.length / PAGE_SIZE));
const page = Math.min(requestedPage ?? 1, pageCount);
if (!hasError && page !== requestedPage) {
	return Astro.redirect(searchHref(query, page));
}

const entries = await withLatestReleases(
	packages.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
);
if (hasError) {
	Astro.response.status = 503;
	Astro.response.headers.set("Retry-After", "30");
} else {
	Astro.cache.set({ ...REGISTRY_PAGE_CACHE, tags: ["registry"] });
}

const summary = hasError ? undefined : resultSummary(query, packages.length);
const keywords = refineKeywords(packages, query);
const title = query ? `Search results for ${query}` : "All plugins";
---

<BaseLayout
	title={page > 1 ? `${title}, page ${page}` : title}
	description={query
		? `Search results for “${query}” in the EmDash plugin registry.`
		: "Browse every plugin in the EmDash plugin registry."}
	canonical={searchHref(query, page)}
	noindex={Boolean(query)}
>
	<SearchHead query={query} summary={summary} keywords={keywords} />

	<section class="search-results shell" aria-labelledby="search-title">
		{
			hasError ? (
				<StatePanel
					icon="refresh"
					title="The registry is taking a moment"
					headingLevel={2}
				>
					Try again shortly. Plugins already installed on your site keep
					working.
					<a
						slot="actions"
						class="btn btn-secondary"
						href={Astro.url.pathname + Astro.url.search}
					>
						Try again
					</a>
				</StatePanel>
			) : entries.length === 0 && !query ? (
				<StatePanel icon="box" title="Plugins are on the way" headingLevel={2}>
					Published plugins will appear here after registry review.
					<a
						slot="actions"
						class="btn btn-secondary"
						href="https://docs.emdashcms.com/plugins/creating-plugins/publishing/"
					>
						Publishing guide
					</a>
				</StatePanel>
			) : entries.length === 0 ? (
				<StatePanel
					icon="search"
					title={`No plugins match “${query}”`}
					headingLevel={2}
				>
					Try a different keyword or a publisher handle, or browse every plugin.
					<a slot="actions" class="btn btn-primary" href="/search">
						Browse all plugins
					</a>
				</StatePanel>
			) : (
				<>
					<ul class="plugin-grid">
						{entries.map((entry) => (
							<li>
								<PluginCard entry={entry} headingLevel={2} />
							</li>
						))}
					</ul>
					<SearchPagination query={query} page={page} pageCount={pageCount} />
				</>
			)
		}
	</section>
</BaseLayout>
