---
import NotFoundExhibit from "../components/not-found/NotFoundExhibit.astro";
import SearchField from "../components/SearchField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

Astro.response.status = 404;
const requestedPath = Astro.originPathname.replace(/(.)\/$/, "$1");
---

<BaseLayout
	title="Plugin not found"
	description="The requested plugin is not available in the EmDash registry."
>
	<section class="not-found shell" aria-labelledby="not-found-title">
		<NotFoundExhibit path={requestedPath} />
		<div class="not-found-copy">
			<p class="eyebrow">404</p>
			<h1 id="not-found-title" class="h-page">That plugin isn’t here.</h1>
			<p class="lead not-found-lead">
				It may have moved, been withdrawn, or not be listed in the public
				registry.
			</p>
			<SearchField id="not-found-search" size="md" class="not-found-search" />
			<div class="not-found-actions">
				<a class="btn btn-primary" href="/search">Browse all plugins</a>
				<a class="btn btn-secondary" href="/">Back to home</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		justify-items: center;
		gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
		padding-block-start: clamp(2.5rem, 1.5rem + 4vw, 5rem);
	}

	.not-found-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 45rem;
		text-align: center;
	}

	.not-found-lead {
		max-width: 32rem;
		margin-block-start: 1rem;
	}

	.not-found-copy :global(.not-found-search) {
		margin-block-start: 2rem;
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.625rem;
		margin-block-start: 1.5rem;
	}

	@media (max-width: 479.98px) {
		.not-found-actions {
			flex-direction: column;
			width: 100%;
		}
	}
</style>
