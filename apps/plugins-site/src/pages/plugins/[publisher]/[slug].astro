<script>
	import {
		normalizeSiteOrigin,
		pluginAdminUrl,
		probeEmDashSite,
	} from "../../../lib/install.js";

	const COPY_FEEDBACK_MS = 2_000;
	const SITE_STORAGE_KEY = "emdash:plugins-site:last-site-origin:v1";

	document
		.querySelectorAll<HTMLButtonElement>("[data-copy-identifier]")
		.forEach((button) => {
			button.addEventListener("click", async () => {
				const identifier = button.dataset.copyIdentifier;
				if (!identifier) return;
				try {
					await navigator.clipboard.writeText(identifier);
					button.dataset.copied = "true";
					button.setAttribute("aria-label", `Copied ${identifier}`);
					const status = button.querySelector<HTMLElement>(".copy-status");
					if (status) status.textContent = "Copied";
					window.setTimeout(() => {
						delete button.dataset.copied;
						button.setAttribute("aria-label", `Copy ${identifier}`);
						if (status) status.textContent = "";
					}, COPY_FEEDBACK_MS);
				} catch {
					const status = button.querySelector<HTMLElement>(".copy-status");
					if (status) status.textContent = "Copy failed";
				}
			});
		});

	const dialog = document.querySelector<HTMLDialogElement>("[data-install-dialog]");
	const installTrigger = document.querySelector<HTMLButtonElement>(".install-trigger");
	const siteForm = dialog?.querySelector<HTMLFormElement>("[data-install-site-form]");
	const siteInput = dialog?.querySelector<HTMLInputElement>("#emdash-site-url");
	const siteError = dialog?.querySelector<HTMLElement>("#site-url-error");
	const savedSite = dialog?.querySelector<HTMLElement>("[data-saved-site]");
	const savedSiteLink = dialog?.querySelector<HTMLAnchorElement>(
		"[data-saved-site-link]",
	);
	const savedSiteHost = dialog?.querySelector<HTMLElement>("[data-saved-site-host]");
	const changeSite = dialog?.querySelector<HTMLButtonElement>("[data-change-site]");
	const siteSubmit = siteForm?.querySelector<HTMLButtonElement>("button[type='submit']");

	function readSavedSite(): string | undefined {
		try {
			const stored = localStorage.getItem(SITE_STORAGE_KEY);
			const origin = stored ? normalizeSiteOrigin(stored) : undefined;
			if (stored && !origin) localStorage.removeItem(SITE_STORAGE_KEY);
			return origin;
		} catch {
			return undefined;
		}
	}

	function destinationFor(origin: string): string | undefined {
		const publisher = dialog?.dataset.publisher;
		const slug = dialog?.dataset.slug;
		if (!publisher || !slug) return undefined;
		return pluginAdminUrl(origin, publisher, slug);
	}

	function showSiteForm(origin?: string) {
		if (!siteForm || !savedSite || !siteInput) return;
		savedSite.hidden = true;
		siteForm.hidden = false;
		siteInput.value = origin ?? "";
		siteInput.removeAttribute("aria-invalid");
		if (siteError) siteError.textContent = "";
		queueMicrotask(() => siteInput.focus());
	}

	function showSavedSite(origin: string) {
		if (!siteForm || !savedSite || !savedSiteLink || !savedSiteHost) return;
		const destination = destinationFor(origin);
		if (!destination) return showSiteForm(origin);
		const host = new URL(origin).host;
		siteForm.hidden = true;
		savedSite.hidden = false;
		savedSiteLink.href = destination;
		savedSiteLink.setAttribute("aria-label", `Open in ${host}`);
		savedSiteHost.textContent = host;
	}

	installTrigger?.addEventListener("click", () => {
		if (!dialog) return;
		const origin = readSavedSite();
		if (origin) showSavedSite(origin);
		else showSiteForm();
		dialog.showModal();
	});

	changeSite?.addEventListener("click", () => {
		showSiteForm(readSavedSite());
	});

	siteForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!siteInput) return;
		const origin = normalizeSiteOrigin(siteInput.value);
		const destination = origin ? destinationFor(origin) : undefined;
		if (!origin || !destination) {
			siteInput.setAttribute("aria-invalid", "true");
			if (siteError) {
				siteError.textContent =
					"Enter an HTTPS site address, or a local HTTP address for development.";
			}
			siteInput.focus();
			return;
		}

		siteInput.removeAttribute("aria-invalid");
		siteForm.setAttribute("aria-busy", "true");
		if (siteError) siteError.textContent = "Checking this site…";
		if (siteSubmit) {
			siteSubmit.disabled = true;
			siteSubmit.textContent = "Checking site…";
		}

		const controller = new AbortController();
		const timeout = window.setTimeout(() => controller.abort(), 4_000);
		const probe = await probeEmDashSite(origin, controller.signal);
		window.clearTimeout(timeout);

		if (probe === "registry-disabled") {
			siteInput.setAttribute("aria-invalid", "true");
			if (siteError) {
				siteError.textContent =
					"This EmDash site does not have the plugin registry enabled.";
			}
			siteForm.removeAttribute("aria-busy");
			if (siteSubmit) {
				siteSubmit.disabled = false;
				siteSubmit.textContent = "Continue to your site";
			}
			return;
		}

		try {
			localStorage.setItem(SITE_STORAGE_KEY, origin);
		} catch {
			// Browser storage may be disabled; the handoff does not depend on it.
		}
		window.location.assign(destination);
	});

	dialog?.addEventListener("click", (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>
