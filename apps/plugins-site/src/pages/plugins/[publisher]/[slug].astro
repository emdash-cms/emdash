<script>
	const COPY_FEEDBACK_MS = 2_000;

	document
		.querySelectorAll<HTMLButtonElement>("[data-copy-public-name]")
		.forEach((button) => {
			const status =
				button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
			let reset: number | undefined;
			button.addEventListener("click", async () => {
				const publicName = button.dataset.copyPublicName;
				if (!publicName) return;
				window.clearTimeout(reset);
				try {
					await navigator.clipboard.writeText(publicName);
					button.dataset.copied = "true";
					if (status) status.textContent = "Copied";
				} catch {
					delete button.dataset.copied;
					if (status) status.textContent = "Copy failed";
				}
				reset = window.setTimeout(() => {
					delete button.dataset.copied;
					if (status) status.textContent = "";
				}, COPY_FEEDBACK_MS);
			});
		});
</script>
