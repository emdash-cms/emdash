---
/** A ghost plugin card on the homepage's framed, dotted stage, captioned with the missing path. */
interface Props {
	path: string;
}

const { path } = Astro.props;
---

<div class="nf-exhibit" aria-hidden="true">
	<div class="nf-stage"></div>
	<div class="nf-card">
		<div class="nf-card-head">
			<span class="nf-icon">
				<svg viewBox="5 5 14 14" focusable="false">
					<path
						d="M9.75 9.5a2.25 2.25 0 1 1 3.2 2.04c-.58.27-.95.84-.95 1.48v.48"
					></path>
					<path d="M12 16.5v.01"></path>
				</svg>
			</span>
			<span class="nf-lines">
				<span class="nf-line nf-line--title"></span>
				<span class="nf-line nf-line--handle"></span>
			</span>
		</div>
		<span class="nf-line nf-line--body"></span>
		<span class="nf-line nf-line--body nf-line--short"></span>
		<div class="nf-card-foot">
			<span class="nf-path" dir="auto">{path}</span>
			<span class="nf-status pill">Not in the registry</span>
		</div>
	</div>
	<span class="nf-mark nf-mark--ss"></span>
	<span class="nf-mark nf-mark--se"></span>
	<span class="nf-mark nf-mark--es"></span>
	<span class="nf-mark nf-mark--ee"></span>
</div>

<style>
	.nf-exhibit {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		width: 100%;
		max-width: 560px;
		margin-inline: auto;
		padding: clamp(2.5rem, 1.75rem + 3vw, 3.75rem)
			clamp(1.25rem, 0.5rem + 4vw, 3.5rem);
		overflow: hidden;
		background: linear-gradient(
			to bottom,
			var(--page),
			color-mix(in srgb, var(--surface-soft) 55%, var(--page))
		);
		border: 1px solid var(--line);
	}

	.nf-stage {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			color-mix(in srgb, var(--ink) 13%, transparent) 1px,
			transparent 1.2px
		);
		background-size: 14px 14px;
		background-position: center;
		-webkit-mask-image: radial-gradient(
			ellipse 60% 70% at 50% 50%,
			#000 30%,
			transparent 100%
		);
		mask-image: radial-gradient(
			ellipse 60% 70% at 50% 50%,
			#000 30%,
			transparent 100%
		);
	}

	.nf-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.625rem;
		width: min(100%, 22.5rem);
		min-width: 0;
		padding: 1.125rem;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius-lg);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--line-soft) 60%, transparent);
	}

	.nf-card-head {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-block-end: 0.25rem;
	}

	.nf-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--subtle);
		border: 1.5px dashed var(--line-strong);
		border-radius: var(--radius-md);
	}

	.nf-icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.75;
	}

	.nf-lines {
		display: grid;
		flex: 1;
		gap: 0.5rem;
		min-width: 0;
	}

	.nf-line {
		display: block;
		height: 0.5rem;
		background: var(--fill-active);
		border-radius: var(--radius-full);
	}

	.nf-line--title {
		width: 58%;
		height: 0.625rem;
	}

	.nf-line--handle {
		width: 36%;
		background: var(--fill);
	}

	.nf-line--body {
		width: 100%;
		background: var(--fill);
	}

	.nf-line--short {
		width: 72%;
	}

	.nf-card-foot {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-block-start: 0.375rem;
		padding-block-start: 0.875rem;
		border-block-start: 1px dashed var(--line-strong);
	}

	.nf-path {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.nf-status {
		flex: none;
		color: var(--ink);
		white-space: nowrap;
	}

	.nf-status::before {
		width: 6px;
		height: 6px;
		content: "";
		background: var(--accent);
		border-radius: 50%;
	}

	.nf-mark {
		position: absolute;
		width: 14px;
		height: 14px;
		background:
			linear-gradient(var(--line-strong), var(--line-strong)) center / 6px 1px
				no-repeat,
			linear-gradient(var(--line-strong), var(--line-strong)) center / 1px 6px
				no-repeat,
			var(--page);
		border: 1px solid var(--line-strong);
		border-radius: 50%;
	}

	.nf-mark--ss {
		inset-block-start: 10px;
		inset-inline-start: 10px;
	}

	.nf-mark--se {
		inset-block-start: 10px;
		inset-inline-end: 10px;
	}

	.nf-mark--es {
		inset-block-end: 10px;
		inset-inline-start: 10px;
	}

	.nf-mark--ee {
		inset-block-end: 10px;
		inset-inline-end: 10px;
	}

	@media (max-width: 379.98px) {
		.nf-card-foot {
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.nf-path {
			flex-basis: 100%;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.nf-card {
			animation: nf-rise 700ms var(--ease-out) 120ms both;
		}
	}

	@keyframes nf-rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}
</style>
