---
/** The closing "where next" panel on catalog pages: a heading, keyword links, and actions. */
interface Props {
	title: string;
	text?: string;
	keywords?: string[];
}

const { title, text, keywords = [] } = Astro.props;
---

<section class="explore shell" aria-labelledby="explore-title">
	<div class="explore-panel card">
		<div class="explore-copy">
			<p class="eyebrow">Keep exploring</p>
			<h2 id="explore-title" class="explore-title" dir="auto">
				{title}
			</h2>
			{text && <p class="explore-text">{text}</p>}
		</div>
		<div class="explore-links">
			{
				keywords.length > 0 && (
					<div class="explore-keywords">
						<span class="explore-keywords-label" id="explore-keywords-label">
							Related keywords
						</span>
						<ul class="chip-list" aria-labelledby="explore-keywords-label">
							{keywords.map((keyword) => (
								<li>
									<a
										class="chip"
										href={`/search?q=${encodeURIComponent(keyword)}`}
										dir="auto"
									>
										<span class="chip-label">{keyword}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			<div class="explore-actions">
				<slot />
			</div>
		</div>
	</div>
</section>

<style>
	.explore {
		padding-block-start: var(--section-space);
	}

	.explore-panel {
		position: relative;
		display: grid;
		gap: 2rem;
		overflow: hidden;
		padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
	}

	.explore-panel::before {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		background-image: radial-gradient(
			color-mix(in srgb, var(--ink) 13%, transparent) 1px,
			transparent 1.2px
		);
		background-size: 14px 14px;
		-webkit-mask-image: radial-gradient(
			ellipse 55% 90% at 100% 50%,
			#000 10%,
			transparent 70%
		);
		mask-image: radial-gradient(
			ellipse 55% 90% at 100% 50%,
			#000 10%,
			transparent 70%
		);
	}

	.explore-panel:dir(rtl)::before {
		-webkit-mask-image: radial-gradient(
			ellipse 55% 90% at 0% 50%,
			#000 10%,
			transparent 70%
		);
		mask-image: radial-gradient(
			ellipse 55% 90% at 0% 50%,
			#000 10%,
			transparent 70%
		);
	}

	.explore-copy,
	.explore-links {
		position: relative;
		min-width: 0;
	}

	.explore-copy .eyebrow {
		margin-bottom: 0.75rem;
	}

	.explore-title {
		margin: 0;
		color: var(--ink-strong);
		font-size: clamp(1.625rem, 1.25rem + 1.3vw, 2.25rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}


	.explore-text {
		max-width: 30rem;
		margin: 0.875rem 0 0;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.explore-links {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 1.25rem;
	}

	.explore-keywords {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 12px;
	}

	.explore-keywords-label {
		color: var(--muted);
		font-size: 13px;
		font-weight: 500;
	}

	.explore-keywords .chip {
		background: color-mix(in srgb, var(--surface-soft) 85%, transparent);
	}

	@media (hover: hover) {
		.explore-keywords .chip:hover {
			background: var(--fill-hover);
		}
	}

	.explore-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		max-width: 100%;
	}

	.explore-actions > :global(*) {
		max-width: 100%;
	}

	@media (max-width: 479.98px) {
		.explore-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.explore-actions > :global(.btn) {
			min-height: 44px;
			white-space: normal;
			text-align: center;
			line-height: 1.3;
			overflow-wrap: anywhere;
		}
	}

	@media (min-width: 900px) {
		.explore-panel {
			align-items: end;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 3rem;
		}

		.explore-links {
			align-items: flex-end;
		}

		.explore-keywords {
			justify-content: flex-end;
		}
	}
</style>
