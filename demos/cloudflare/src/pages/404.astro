---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="band not-found">
		<div class="not-found__backdrop" aria-hidden="true"></div>
		<div class="frame not-found__inner">
			<p class="eyebrow not-found__code">Error 404</p>
			<h1 class="intro__title">Page not found</h1>
			<p class="intro__lead">
				The page you’re looking for doesn’t exist or may have moved.
			</p>
			<div class="not-found__actions">
				<a href="/" class="btn">Go home</a>
				<a href="/posts" class="btn btn--ghost">Browse posts</a>
			</div>
			<button type="button" class="not-found__search" data-search-trigger>
				<svg
					class="not-found__search-icon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
					></path></svg
				>
				Or search posts
			</button>
		</div>
	</section>
</Base>

<script>
	document.querySelector(".not-found__search")?.addEventListener("click", () => {
		document.querySelector<HTMLElement>("[data-ai-search-trigger]")?.click();
	});
</script>

<style>
	.not-found {
		padding-block: clamp(4rem, 2.5rem + 6vw, 8rem);
	}

	.not-found__backdrop {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			circle,
			var(--color-border-strong) 1px,
			transparent 1.5px
		);
		background-position: center;
		background-size: 16px 16px;
		mask-image: radial-gradient(
			ellipse 46% 58% at 50% 50%,
			#000 15%,
			transparent 75%
		);
		pointer-events: none;
	}

	.not-found__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.not-found__code {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		min-height: 28px;
		padding: 2px 12px;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		box-shadow:
			inset 0 0 0 1px var(--color-border),
			var(--shadow-sm);
		color: var(--color-text-secondary);
	}

	.not-found__code::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: var(--radius-full);
		background: var(--color-muted);
	}

	.not-found__inner .intro__lead {
		max-width: 40ch;
		text-wrap: balance;
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-3);
		margin-top: var(--spacing-8);
	}

	.not-found__search {
		position: relative;
		display: block;
		width: min(100%, 340px);
		height: 44px;
		margin-top: var(--spacing-6);
		padding-block: 0;
		padding-inline: 42px 16px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-muted);
		font: inherit;
		font-size: var(--font-size-base);
		text-align: start;
		cursor: pointer;
		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.not-found__search:hover {
		border-color: var(--color-border-strong);
	}

	/* Transparent rather than none so forced-colors mode still draws a ring */
	.not-found__search:focus-visible {
		outline: 2px solid transparent;
		border-color: var(--color-muted);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.not-found__search-icon {
		position: absolute;
		inset-inline-start: 16px;
		top: 50%;
		width: 16px;
		height: 16px;
		translate: 0 -50%;
		pointer-events: none;
	}
</style>
