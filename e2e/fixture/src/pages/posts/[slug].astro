---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead, PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";

interface Props {
	locale?: string;
}

const { slug } = Astro.params;
const { locale } = Astro.props;
if (!slug) return Astro.redirect("/404");
const { entry: post } = await getEmDashEntry("posts", slug, { locale });
if (!post) return new Response("Not found", { status: 404 });

const seo = getSeoMeta(post, {
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const pageCtx = createPublicPageContext({
	Astro,
	kind: "content",
	pageType: "article",
	title: String(post.data.title),
	description: typeof post.data.excerpt === "string" ? post.data.excerpt : null,
	canonical: seo.canonical,
	content: { collection: "posts", id: post.data.id, slug: post.data.slug },
});
---

<html>
	<head>
		<meta charset="utf-8" />
		<title>{post.data.title}</title>
		<EmDashHead page={pageCtx} />
		{seo.canonical && <link rel="canonical" href={seo.canonical} />}
		<style>
			#body :global(pre) {
				padding-block: 1.25rem;
				border: 1px solid #d1d5db;
			}
			#body :global(pre), #body :global(pre code) {
				background: #181818;
				color: #ffffff;
				font-size: 1rem;
			}
		</style>
	</head>
	<body>
		<article>
			<h1 id="title">{post.data.title}</h1>
			{post.data.excerpt && <p id="excerpt">{post.data.excerpt}</p>}
			<div id="body"><PortableText value={post.data.body} /></div>
		</article>
		<Comments collection="posts" contentId={post.data.id} threaded />
		<CommentForm collection="posts" contentId={post.data.id} />
	</body>
</html>
