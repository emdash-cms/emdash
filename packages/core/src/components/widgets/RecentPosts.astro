---
import { getEmDashCollection } from "../../query.js";
import { getI18nConfig } from "../../i18n/config.js";
import { getSiteSettings } from "../../settings/index.js";
import EmDashImage from "../EmDashImage.astro";
import {
	createPublishedDateFormatter,
	isThumbnailImage,
	toPublishedDate,
} from "../../widgets/recent-posts.js";

interface Props {
	count?: number;
	showThumbnails?: boolean;
	showDate?: boolean;
}

const { count = 5, showThumbnails = false, showDate = true } = Astro.props;

const [{ entries: posts }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		limit: count,
		orderBy: { published_at: "desc" },
	}),
	showDate ? getSiteSettings() : undefined,
]);

const dateFormatter = createPublishedDateFormatter({
	locale: Astro.currentLocale ?? getI18nConfig()?.defaultLocale,
	timezone: settings?.timezone,
});

function getTitle(data: Record<string, unknown>): string | undefined {
	return typeof data.title === "string" ? data.title : undefined;
}
---

<ul class="widget-recent-posts">
	{
		posts.map((post) => {
			const title = getTitle(post.data);
			const publishedAt = toPublishedDate(post.data.publishedAt);
			const featuredImage = post.data.featured_image;
			return (
				<li>
					{showThumbnails && isThumbnailImage(featuredImage) && (
						<EmDashImage
							image={featuredImage}
							alt=""
							width={96}
							height={96}
							class="widget-recent-posts__thumbnail"
						/>
					)}
					<a href={`/posts/${post.id}`} class="widget-recent-posts__link">
						{title}
					</a>
					{showDate && publishedAt && (
						<time
							datetime={publishedAt.toISOString()}
							class="widget-recent-posts__date"
						>
							{dateFormatter.format(publishedAt)}
						</time>
					)}
				</li>
			);
		})
	}
</ul>
