# Emdash Core Configuration

# Database connection (configured via migrations)
# Emdash uses SQLite by default with tenant_id columns for multi-tenant support
DATABASE_URL=file:./emdash.db

# Multi-Tenant Configuration
# Tenant ID extraction for request context
# Default: 'default' (single-tenant fallback)
DEFAULT_TENANT_ID=default

# Request Context
# AsyncLocalStorage is used to propagate tenant context through request lifecycle
# Tenant is extracted from (in priority order):
# 1. X-Tenant-ID header (API calls)
# 2. ?tenant_id query parameter (development)
# 3. emdash-tenant-id cookie (session)
# 4. Subdomain (tenant.example.com)
# 5. Fallback to DEFAULT_TENANT_ID

# Middleware Configuration
# Enable tenant extraction middleware
ENABLE_TENANT_EXTRACTION=true

# Logging
LOG_LEVEL=info
