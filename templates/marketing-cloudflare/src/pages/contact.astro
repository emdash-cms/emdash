---
import { Icon } from "astro-iconset/components";
import { getEmDashEntry, getSeoMeta } from "emdash";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/contact",
			defaultDescription: "Have questions or want a demo? Talk directly with the Acme team.",
		})
	: null;

const contactMethods = [
	{
		icon: "ph:envelope",
		title: "General questions",
		description: "Ask about Acme, partnerships, or anything else.",
		label: "hello@acme.example",
		href: "mailto:hello@acme.example",
	},
	{
		icon: "ph:lifebuoy",
		title: "Customer support",
		description: "Get help with your account or an existing project.",
		label: "support@acme.example",
		href: "mailto:support@acme.example",
	},
	{
		icon: "ph:currency-dollar",
		title: "Sales",
		description: "Discuss plans, procurement, and your team's needs.",
		label: "sales@acme.example",
		href: "mailto:sales@acme.example",
	},
];
---

<Base
	title={seo?.title || "Contact"}
	pageTitle={page?.data.title || "Contact"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{page?.data.content && (
		<div {...page.edit.content}>
			<MarketingBlocks value={page.data.content} />
		</div>
	)}

	<section class="contact-section section" aria-labelledby="contact-heading">
		<div class="container contact-container">
			<div class="contact-intro">
				<p class="contact-eyebrow">Talk to a real person</p>
				<h2 id="contact-heading">Choose the team that can help</h2>
				<p>
					Email us directly and include any useful context. We will reply from the address you
					contacted.
				</p>
			</div>

			<div class="contact-grid">
				{contactMethods.map((method) => (
					<article class="contact-card">
						<div class="icon-tile contact-icon">
							<Icon name={method.icon} aria-hidden="true" />
						</div>
						<h3>{method.title}</h3>
						<p>{method.description}</p>
						<a class="contact-link" href={method.href}>
							{method.label}
							<span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</div>
		</div>
	</section>
</Base>

<style>
	.contact-section {
		padding-top: var(--spacing-xl);
		padding-bottom: var(--spacing-5xl);
	}

	.contact-container {
		display: grid;
		gap: var(--spacing-3xl);
	}

	.contact-intro {
		max-width: var(--max-width);
		margin: 0 auto;
		text-align: center;
	}

	.contact-eyebrow {
		margin-bottom: var(--spacing-sm);
		color: var(--color-brand);
		font-size: var(--font-size-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.contact-intro h2 {
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-3xl);
	}

	.contact-intro > p:last-child {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-xl);
	}

	.contact-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--spacing-xl);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.contact-icon {
		margin-bottom: var(--spacing-lg);
	}

	.contact-card h3 {
		margin-bottom: var(--spacing-sm);
		font-size: var(--font-size-xl);
	}

	.contact-card p {
		flex: 1;
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
	}

	.contact-link {
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: var(--spacing-sm);
		color: var(--color-brand);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
		overflow-wrap: anywhere;
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
