---
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageTitle = page?.data.title;
const pageContent = page?.data.content;
const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultDescription:
				"Halden connects to the meters and systems your buildings already have, finds wasted energy and fixes it automatically.",
		})
	: null;
---

<Base
	title={seo?.title !== "Home" ? seo?.title : undefined}
	pageTitle={pageTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page && pageContent ? (
			<div class="page-blocks" {...page.edit.content}>
				<MarketingBlocks value={pageContent} />
			</div>
		) : (
			<section class="container empty-state">
				<h1 class="display empty-state__title">Your homepage is empty</h1>
				<p class="lead">Add blocks to this page in the admin to get started.</p>
				{Astro.locals.user && (
					<div class="actions">
						<a href="/_emdash/admin" class="btn btn-lg">
							Open admin
						</a>
					</div>
				)}
			</section>
		)
	}
</Base>
