---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type PricingBlock = Extract<PageContentBlock, { _type: "marketing_pricing" }>;
type Props = BlockComponentProps<PricingBlock>;

const { value } = Astro.props;
const { anchor_id, headline, plans: rawPlans } = value;
const PlanHeading = headline ? "h3" : "h2";

const plans = rawPlans.map((plan) => ({
	...plan,
	badge: plan.badge?.trim() || (plan.highlighted ? "Most popular" : undefined),
	features: (plan.features ?? "")
		.split("\n")
		.map((s) => s.trim())
		.filter(Boolean),
	cta: {
		label: plan.cta_label,
		url: sanitizeHref(plan.cta_url),
	},
}));
---

<section id={anchor_id || undefined} class="container section">
	{
		headline && (
			<header class="section-header section-header--center">
				<h2 class="section-headline">{headline}</h2>
			</header>
		)
	}
	<ul
		class:list={["plans", { "plans--single": plans.length === 1 }]}
		role="list"
	>
		{
			plans.map((plan) => (
				<li class:list={["card", "plan", { "plan--highlighted": plan.highlighted }]}>
					<div class="plan__head">
						<PlanHeading class="plan__name">{plan.name}</PlanHeading>
						{plan.badge && <span class="plan__badge">{plan.badge}</span>}
					</div>
					<p class="plan__price">
						<span class="display plan__amount">{plan.price}</span>
						{plan.period && " "}
						{plan.period && <span class="plan__period">{plan.period}</span>}
					</p>
					{plan.description && (
						<p class="plan__description">{plan.description}</p>
					)}
					{plan.features.length > 0 && (
						<ul class="plan__features" role="list">
							{plan.features.map((feature) => (
								<li>
									<span class="tick" aria-hidden="true">
										<Icon name="ph:check" />
									</span>
									{feature}
								</li>
							))}
						</ul>
					)}
					<div class="plan__action">
						<a
							href={plan.cta.url}
							class:list={[
								"btn",
								"btn-lg",
								plan.highlighted ? "btn-light" : "btn-secondary",
							]}
						>
							{plan.cta.label}
						</a>
					</div>
				</li>
			))
		}
	</ul>
</section>

<style>
	.plans {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		align-items: stretch;
		gap: 16px;
		list-style: none;
	}

	.plans--single {
		max-width: 440px;
		margin-inline: auto;
	}

	.plan {
		display: flex;
		flex-direction: column;
		padding: 32px;
		border-radius: 24px;
	}

	.plan__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 12px;
		/* The badge height, so prices line up across plans with and without a badge */
		min-height: 24px;
	}

	.plan__name {
		font-size: 15px;
		line-height: 1.4;
		letter-spacing: normal;
		color: var(--color-text-secondary);
	}

	.plan__badge {
		display: inline-flex;
		align-items: center;
		height: 24px;
		margin-inline-start: auto;
		padding-inline: 10px;
		border-radius: var(--radius-full);
		background: var(--color-sunken);
		color: var(--color-text-secondary);
		font-size: 12.5px;
		font-weight: 500;
		white-space: nowrap;
	}

	.plan__price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 8px;
		margin-block-start: 20px;
	}

	.plan__amount {
		font-size: clamp(48px, 4.6vw, 64px);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.plan__period {
		font-size: 14px;
		color: var(--color-muted);
	}

	.plan__description {
		margin-block-start: 16px;
		font-size: 15px;
		line-height: 1.55;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.plan__features {
		display: grid;
		gap: 12px;
		margin-block-start: 28px;
		list-style: none;
	}

	.plan__features li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		font-size: 14.5px;
		color: var(--color-text-secondary);
	}

	.plan__action {
		margin-block-start: auto;
		padding-block-start: 32px;
	}

	.plan__action .btn {
		width: 100%;
	}

	.plan--highlighted {
		background: var(--glow-dusk), var(--color-night);
		color: var(--color-on-night);
	}

	.plan--highlighted :is(.plan__name, .plan__period, .plan__description, .plan__features li) {
		color: var(--color-on-night-muted);
	}

	.plan--highlighted .plan__badge {
		background: rgb(255 255 255 / 0.12);
		color: var(--color-on-night);
	}

	.plan--highlighted .tick {
		background: rgb(255 255 255 / 0.12);
		color: var(--color-on-night);
	}
</style>
