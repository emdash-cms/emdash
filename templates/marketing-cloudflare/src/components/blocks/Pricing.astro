---
interface RawPlan {
	name: string;
	price: string;
	period?: string;
	description?: string;
	// Features are stored as a newline-separated string because Block Kit
	// has no list-of-strings element.
	features?: string;
	// CTAs are flattened to sibling fields because Block Kit has no
	// object-group element.
	ctaLabel?: string;
	ctaUrl?: string;
	highlighted?: boolean;
}

interface Props {
	node: {
		headline?: string;
		plans: RawPlan[];
	};
}

const { node } = Astro.props;
const { headline, plans: rawPlans } = node;

const plans = rawPlans.map((plan) => ({
	...plan,
	features: (plan.features ?? "")
		.split("\n")
		.map((feature) => feature.trim())
		.filter(Boolean),
	cta: {
		label: plan.ctaLabel ?? "",
		url: plan.ctaUrl ?? "#",
	},
}));
---

<section class="pricing section">
	<div class="pricing-container container">
		{
			headline && (
				<header class="pricing-header">
					<h2 class="pricing-headline">{headline}</h2>
				</header>
			)
		}
		<div class="pricing-grid">
			{
				plans.map((plan) => (
					<article
						class:list={[
							"pricing-card",
							{ "pricing-highlighted": plan.highlighted },
						]}
					>
						{plan.highlighted && (
							<div class="pricing-badge">Most popular</div>
						)}
						<div class="pricing-plan-header">
							<h3 class="pricing-name">{plan.name}</h3>
							<div class="pricing-price">
								<span class="pricing-amount">{plan.price}</span>
								{plan.period && (
									<span class="pricing-period">{plan.period}</span>
								)}
							</div>
							{plan.description && (
								<p class="pricing-description">{plan.description}</p>
							)}
						</div>
						<ul class="pricing-features">
							{plan.features.map((feature) => (
								<li>
									<svg
										class="check-icon"
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											fill-rule="evenodd"
											d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
											clip-rule="evenodd"
										/>
									</svg>
									<span>{feature}</span>
								</li>
							))}
						</ul>
						<a
							href={plan.cta.url}
							class:list={[
								"btn",
								"btn-lg",
								"pricing-cta",
								{
									"btn-primary": plan.highlighted,
									"btn-secondary": !plan.highlighted,
								},
							]}
						>
							{plan.cta.label}
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.pricing.section {
		background: color-mix(in srgb, var(--color-bg) 62%, var(--color-surface));
	}

	.pricing-header {
		max-width: 46rem;
		margin: 0 auto var(--spacing-3xl);
		text-align: center;
	}

	.pricing-headline {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		line-height: 1.12;
		letter-spacing: -0.035em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: var(--spacing-lg);
	}

	.pricing-card {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: var(--spacing-lg);
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-border) 30%, transparent),
			var(--shadow-sm);
	}

	.pricing-highlighted {
		background: var(--color-surface-raised);
		border-color: var(--color-brand);
		box-shadow:
			0 0 0 4px var(--color-brand-ring),
			var(--shadow-xl);
		transform: scale(1.02);
	}

	.pricing-badge {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		width: max-content;
		margin-inline: auto;
		padding: var(--spacing-xs) var(--spacing-md);
		color: var(--color-on-brand);
		background: var(--color-brand-strong);
		font-size: var(--font-size-xs);
		font-weight: 600;
		white-space: nowrap;
		border-radius: var(--radius-full);
		transform: translateY(-50%);
	}

	.pricing-plan-header {
		padding-block-end: var(--spacing-lg);
		text-align: center;
		border-block-end: 1px solid var(--color-border);
	}

	.pricing-name {
		margin-block-end: var(--spacing-sm);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		overflow-wrap: anywhere;
	}

	.pricing-price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: var(--spacing-xs);
		margin-block-end: var(--spacing-sm);
	}

	.pricing-amount {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		overflow-wrap: anywhere;
	}

	.pricing-period,
	.pricing-description {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.pricing-description {
		line-height: var(--leading-normal);
		overflow-wrap: anywhere;
	}

	.pricing-features {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--spacing-sm);
		list-style: none;
	}

	.pricing-features li {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
		line-height: 1.5;
	}

	.pricing-features li span {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.check-icon {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		margin-block-start: 2px;
		color: var(--color-success);
	}

	.pricing-cta {
		width: 100%;
	}

	@media (max-width: 900px) {
		.pricing-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.pricing-highlighted {
			transform: none;
		}
	}

	@media (max-width: 600px) {
		.pricing-header {
			margin-block-end: var(--spacing-2xl);
		}
	}
</style>
