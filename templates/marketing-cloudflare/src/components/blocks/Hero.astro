---
interface Props {
	node: {
		_key?: string;
		headline: string;
		subheadline?: string;
		// CTAs are flattened to sibling fields because Block Kit has no
		// object-group element. Empty strings mean "no CTA".
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		image?: { url: string; alt?: string };
		centered?: boolean;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, image, centered } = node;
const headingId = _key ? `${_key}-title` : "hero-title";

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: node.primaryCtaUrl }
		: undefined;
const secondaryCta =
	node.secondaryCtaLabel && node.secondaryCtaUrl
		? { label: node.secondaryCtaLabel, url: node.secondaryCtaUrl }
		: undefined;
const showVisual = Boolean(image || !centered);
---

<section
	class:list={[
		"hero",
		{ "hero-centered": centered, "hero-with-image": Boolean(image) },
	]}
	id={_key}
	aria-labelledby={headingId}
>
	<div class="hero-container">
		<div class="hero-copy">
			<h1 id={headingId} class="hero-headline">{headline}</h1>
			{subheadline && <p class="hero-subheadline">{subheadline}</p>}
			{
				(primaryCta || secondaryCta) && (
					<div class="hero-actions">
						{primaryCta && (
							<a href={primaryCta.url} class="btn btn-primary btn-lg">
								{primaryCta.label}
							</a>
						)}
						{secondaryCta && (
							<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
								{secondaryCta.label}
							</a>
						)}
					</div>
				)
			}
		</div>

		{
			showVisual && (
				<div class="hero-visual-wrap">
					<div class:list={["hero-visual-frame", { "hero-fallback-frame": !image }] }>
						{image ? (
							<img
								src={image.url}
								alt={image.alt || ""}
								class="hero-image"
								loading="eager"
								fetchpriority="high"
							/>
						) : (
							<img
								src="/hero-visual.svg"
								alt=""
								class="hero-art"
								width="2048"
								height="2048"
								loading="eager"
								fetchpriority="high"
							/>
						)}
					</div>
				</div>
			)
		}
	</div>
</section>

<style>
	.hero {
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 62%, var(--color-surface));
	}

	.hero-container {
		max-width: var(--wide-width);
		margin-inline: auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.hero-copy {
		display: flex;
		max-width: 46rem;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-centered .hero-copy {
		align-items: center;
		margin-inline: auto;
		text-align: center;
	}

	.hero-headline {
		max-width: 100%;
		font-size: 2rem;
		font-weight: var(--font-weight-display);
		line-height: 1.06;
		letter-spacing: -0.04em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.hero-subheadline {
		max-width: 38rem;
		margin-block-start: 0.875rem;
		color: var(--color-muted);
		font-size: var(--font-size-base);
		line-height: 1.6;
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
		margin-block-start: var(--spacing-lg);
	}

	.hero-centered .hero-actions {
		align-items: center;
	}

	.hero-actions :global(.btn) {
		width: 100%;
	}

	.hero-visual-wrap {
		width: 100%;
		margin-block-start: var(--spacing-3xl);
	}

	.hero-visual-frame {
		position: relative;
		overflow: hidden;
		width: 100%;
		aspect-ratio: 5 / 3;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow:
			0 0 0 4px var(--color-brand-ring),
			var(--shadow-xl);
	}

	.hero-image,
	.hero-art {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		object-fit: cover;
	}

	.hero-fallback-frame {
		background: color-mix(in srgb, var(--color-surface) 82%, var(--color-bg));
	}

	.hero-art {
		object-fit: contain;
		padding: clamp(0.5rem, 2vw, 1.5rem);
	}

	.hero-centered:not(.hero-with-image) .hero-container {
		padding-block-end: var(--spacing-4xl);
	}

	@media (min-width: 640px) {
		.hero-actions {
			width: auto;
			flex-direction: row;
			align-items: center;
		}

		.hero-actions :global(.btn) {
			width: auto;
		}
	}

	@media (min-width: 641px) {
		.hero-headline {
			font-size: 2.5rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-container {
			padding-block-start: var(--spacing-4xl);
			padding-block-end: var(--spacing-3xl);
		}

		.hero-headline {
			font-size: 3.25rem;
		}

		.hero-subheadline {
			margin-block-start: var(--spacing-md);
			font-size: var(--font-size-lg);
		}

		.hero-actions {
			margin-block-start: var(--spacing-xl);
		}

		.hero-visual-wrap {
			margin-block-start: var(--spacing-4xl);
		}
	}
</style>
