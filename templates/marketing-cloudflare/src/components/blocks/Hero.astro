---
import { sanitizeHref } from "emdash";

interface Props {
	node: {
		_key?: string;
		headline: string;
		subheadline?: string;
		// CTAs are flattened to sibling fields because Block Kit has no
		// object-group element. Empty strings mean "no CTA".
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		image?: { url: string; alt?: string };
		centered?: boolean;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, image, centered } = node;
const headingId = _key ? `${_key}-title` : "hero-title";
const showVisual = Boolean(image || !centered);

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: sanitizeHref(node.primaryCtaUrl.trim()) }
		: undefined;
const secondaryCta =
	node.secondaryCtaLabel && node.secondaryCtaUrl
		? { label: node.secondaryCtaLabel, url: sanitizeHref(node.secondaryCtaUrl.trim()) }
		: undefined;
---

<section class:list={["hero", { "hero-centered": centered }]} id={_key} aria-labelledby={headingId}>
	<div class="hero-section">
		<div class="hero-container">
			<div class="hero-copy">
				<h1 id={headingId} class="hero-headline">{headline}</h1>
				{subheadline && <p class="hero-subheadline">{subheadline}</p>}
				{(primaryCta || secondaryCta) && (
					<div class="hero-actions">
						{primaryCta && (
							<a href={primaryCta.url} class="btn btn-primary btn-lg">
								<span>{primaryCta.label}</span>
							</a>
						)}
						{secondaryCta && (
							<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
								<span>{secondaryCta.label}</span>
							</a>
						)}
					</div>
				)}
			</div>

			{showVisual && (
				<div class="hero-image-wrap">
					<div class:list={["hero-image-frame", { "hero-image-frame--art": !image }] }>
						{image ? (
							<img
								src={image.url}
								alt={image.alt || ""}
								class="hero-image"
								loading="eager"
								fetchpriority="high"
							/>
						) : (
							<img
								src="/hero-visual.svg"
								alt=""
								class="hero-image hero-art"
								width="2048"
								height="2048"
								loading="eager"
								fetchpriority="high"
							/>
						)}
					</div>
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.hero {
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.hero-section {
		position: relative;
	}

	.hero-container {
		position: relative;
		z-index: 10;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 8.5rem var(--spacing-lg) var(--spacing-xl);
	}

	.hero-centered {
		text-align: center;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-centered .hero-copy {
		align-items: center;
		max-width: 100%;
	}

	.hero-headline {
		max-width: var(--wide-width);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.hero-subheadline {
		max-width: 36rem;
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		margin-top: var(--spacing-lg);
		gap: 0.75rem;
	}

	.hero-actions :global(.btn) {
		width: 100%;
	}

	.hero-image-wrap {
		position: relative;
		width: 100%;
		margin-top: var(--spacing-3xl);
	}

	.hero-image-frame {
		position: relative;
		overflow: hidden;
		width: 100%;
		margin: 0 auto;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow:
			0 0 0 4px var(--border-faint),
			0 20px 24px -4px rgba(0, 0, 0, 0.1),
			0 8px 8px -4px rgba(0, 0, 0, 0.04);
	}

	:global(:root.dark) .hero-image-frame {
		border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
			0 20px 24px -4px rgba(0, 0, 0, 0.24),
			0 8px 8px -4px rgba(0, 0, 0, 0.18);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero-image-frame {
			border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
				0 20px 24px -4px rgba(0, 0, 0, 0.24),
				0 8px 8px -4px rgba(0, 0, 0, 0.18);
		}
	}

	.hero-image-frame :global(.hero-image) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
		object-fit: cover;
	}

	.hero-image-frame--art {
		background: color-mix(in srgb, var(--color-surface) 82%, var(--color-bg));
	}

	.hero-image-frame :global(.hero-art) {
		padding: clamp(0.5rem, 2vw, 1.5rem);
		object-fit: contain;
	}

	@media (min-width: 640px) {
		.hero-actions {
			width: auto;
			flex-direction: row;
		}

		.hero-actions :global(.btn) {
			width: fit-content;
		}
	}

	@media (min-width: 1024px) {
		.hero-container {
			padding-top: 10rem;
			padding-bottom: var(--spacing-xl);
		}

		.hero-headline {
			font-size: 3.25rem;
		}

		.hero-subheadline {
			margin-top: var(--spacing-md);
			font-size: var(--font-size-lg);
		}

		.hero-actions {
			margin-top: var(--spacing-xl);
		}
	}

	@media (max-width: 640px) {
		.hero-container {
			padding-top: 7.5rem;
		}

		.hero-headline {
			font-size: var(--font-size-3xl);
		}
	}
</style>
