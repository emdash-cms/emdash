---
import Base from "../layouts/Base.astro";

const contactEmail = "hello@studio.example";
---

<Base title="Contact" description="Get in touch about your next project.">
	<div class="contact-page">
		<header class="contact-header">
			<p class="contact-eyebrow">Start a conversation</p>
			<h1 class="contact-title">Tell us about your project</h1>
			<p class="contact-intro">
				Share what you are making, the problem you need to solve, and any timing
				you have in mind. We will reply by email.
			</p>
		</header>

		<section class="contact-card" aria-labelledby="contact-email-heading">
			<div>
				<h2 id="contact-email-heading">Email the studio</h2>
				<p>Use your email app to send the project details directly.</p>
			</div>
			<a class="contact-link" href={`mailto:${contactEmail}`}>
				{contactEmail}
				<span aria-hidden="true">→</span>
			</a>
		</section>

	</div>
</Base>

<style>
	.contact-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
	}

	.contact-header {
		max-width: var(--max-width);
		margin-bottom: var(--spacing-3xl);
	}

	.contact-eyebrow {
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.contact-title {
		margin-bottom: var(--spacing-lg);
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.contact-intro {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.contact-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-2xl);
		padding: var(--spacing-2xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.contact-card h2 {
		margin-bottom: var(--spacing-xs);
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
	}

	.contact-card p {
		color: var(--color-muted);
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-md) var(--spacing-xl);
		color: var(--color-bg);
		background: var(--color-text);
		text-decoration: none;
		border-radius: var(--radius);
		transition:
			background var(--transition-fast),
			transform var(--transition-fast);
	}

	.contact-link:hover {
		color: var(--color-on-brand);
		background: var(--color-brand);
		transform: translateY(-1px);
	}

	@media (max-width: 768px) {
		.contact-title {
			font-size: var(--font-size-3xl);
		}

		.contact-card {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 480px) {
		.contact-link {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
