---
export const prerender = false;

import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

// Get filter from query param. When set, push the filter down to the
// database via `where` instead of loading every project and filtering
// in JS — that pattern scales O(projects × terms-per-project) and
// blows up the moment you have more than a couple of dozen entries.
const activeTag = Astro.url.searchParams.get("tag");
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

const [projectsResult, tagsResult] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 12,
		cursor,
		...(activeTag ? { where: { tag: activeTag } } : {}),
	}),
	getTaxonomyTermsWithCacheHint("tag", { includeCounts: false }),
]);
if (projectsResult.error) {
	return new Response("Could not load the portfolio", { status: 500 });
}

const { entries: projects, nextCursor } = projectsResult;
const tags = tagsResult.data;
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(tagsResult.cacheHint);
}

const activeTerm = activeTag
	? tags.find((t) => t.slug === activeTag)
	: undefined;
const activeLabel = activeTerm?.label || activeTag;

// A count is only accurate when the whole list fits on this page.
const showCount = projects.length > 0 && !cursor && !nextCursor;

// Rows are numbered across pages: the next-page link carries the number
// its first row starts from.
const fromParam = Number(Astro.url.searchParams.get("from"));
const firstNumber =
	cursor && Number.isSafeInteger(fromParam) && fromParam > 0
		? Math.min(fromParam, 99_999)
		: 1;

function pad(n: number): string {
	return String(n).padStart(2, "0");
}

function workUrl(next: string): string {
	const params = new URLSearchParams({ cursor: next });
	if (activeTag) params.set("tag", activeTag);
	params.set("from", String(firstNumber + projects.length));
	return `/work?${params.toString()}`;
}

// Each row renders its image twice: an inline thumbnail for touch screens
// and narrower windows, and a preview beside the list on wide screens with
// a pointer. Both are lazy, so only the kind shown at the current width
// downloads; on wide screens every row's preview loads with the page so a
// hover shows it at once.
const thumbSizes = "(min-width: 1024px) 128px, (min-width: 768px) 112px, 88px";
const previewSizes = "(min-width: 1680px) 384px, 25vw";
---

<Base title={activeLabel ? `${activeLabel} — Work` : "Work"}>
	<div class="work frame">
		<header class="work-head">
			<h1 class="work-title">
				Work
				{
					showCount && (
						<span class="work-count label" aria-hidden="true">
							({pad(projects.length)})
						</span>
					)
				}
			</h1>
			<p class="work-intro">An index of every project, newest first.</p>
			{
				tags.length > 0 && (
					<nav class="work-filter" aria-label="Filter by discipline">
						<ul role="list">
							<li>
								<a
									href="/work"
									class="label"
									aria-current={activeTag ? undefined : "page"}
								>
									All
								</a>
							</li>
							{tags.map((tag) => (
								<li>
									<a
										href={`/work?tag=${encodeURIComponent(tag.slug)}`}
										class="label"
										aria-current={activeTag === tag.slug ? "page" : undefined}
									>
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</header>

		{
			projects.length > 0 ? (
				<>
					<div class="work-ledger">
						<div class="work-cols label" aria-hidden="true">
							<span class="col-num">No.</span>
							<span class="col-name">Project</span>
							<span class="col-client">Client</span>
							<span class="col-tags">Discipline</span>
							<span class="col-year">Year</span>
						</div>
						<ol class="work-list" role="list">
							{projects.map((project, i) => {
								const image = project.data.featured_image;
								const { client, year } = project.data;
								const disciplines = (project.data.terms?.tag ?? [])
									.map((term) => term.label)
									.join(", ");
								return (
									<li class="work-item">
										<div class="work-row media-group">
											<span
												class="work-row__thumb media"
												aria-hidden="true"
												{...project.edit.featured_image}
											>
												{image && (
													<Image
														image={image}
														alt=""
														width={320}
														height={240}
														sizes={thumbSizes}
													/>
												)}
											</span>
											<span class="work-row__num col-num label" aria-hidden="true">
												{pad(firstNumber + i)}
											</span>
											<h2 class="work-row__name col-name">
												<a href={`/work/${project.id}`} class="work-row__link">
													<span {...project.edit.title}>
														{project.data.title || "Untitled"}
													</span>
												</a>
											</h2>
											{(client || disciplines) && (
												<div class="work-row__meta">
													{client && (
														<span
															class="work-row__client col-client"
															{...project.edit.client}
														>
															{client}
														</span>
													)}
													{disciplines && (
														<span class="work-row__tags col-tags">{disciplines}</span>
													)}
												</div>
											)}
											{year && (
												<span
													class="work-row__year col-year label"
													{...project.edit.year}
												>
													{year}
												</span>
											)}
										</div>
										{image && (
											<div class="work-preview" aria-hidden="true">
												<div class="work-preview__plate media">
													<Image
														image={image}
														alt=""
														width={480}
														height={600}
														sizes={previewSizes}
													/>
												</div>
											</div>
										)}
									</li>
								);
							})}
						</ol>
					</div>
					{nextCursor && (
						<nav class="work-more" aria-label="Pagination">
							<a href={workUrl(nextCursor)} rel="next" class="arrow-link">
								More projects
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M4 12h16M13 5l7 7-7 7" />
								</svg>
							</a>
						</nav>
					)}
				</>
			) : (
				<div class="work-empty">
					{activeTag ? (
						<>
							<h2 class="work-empty__title">
								{activeTerm
									? `No ${activeTerm.label} projects yet.`
									: "No projects found with this tag."}
							</h2>
							<a href="/work" class="btn btn--ghost">
								View all projects
							</a>
						</>
					) : (
						<>
							<h2 class="work-empty__title">No projects yet.</h2>
							<p class="work-empty__text">
								Add your first project in the admin and it will appear here.
							</p>
							<a href="/_emdash/admin/content/projects/new" class="btn">
								Add a project
							</a>
						</>
					)}
				</div>
			)
		}
	</div>
</Base>

<style>
	/* Head */
	.work-head {
		padding-block: var(--page-head-space) var(--spacing-2xl);
	}

	.work-title {
		display: flex;
		align-items: flex-start;
		gap: 0.1em;
		font-size: var(--font-size-title);
		line-height: var(--leading-none);
		overflow-wrap: anywhere;
	}

	.work-count {
		margin-block-start: 0.5em;
	}

	.work-intro {
		max-width: 34ch;
		margin-block-start: var(--spacing-lg);
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		color: var(--color-text-secondary);
	}

	.work-filter {
		margin-block-start: var(--spacing-2xl);
	}

	.work-filter ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-lg);
		list-style: none;
	}

	.work-filter a {
		display: inline-block;
		padding-block: 0.4rem;
		overflow-wrap: anywhere;
		text-decoration-line: none;
		text-underline-offset: 0.4em;
		transition: color var(--transition-fast);
	}

	.work-filter a:is(:hover, :focus-visible) {
		color: var(--color-text);
	}

	.work-filter a[aria-current="page"] {
		color: var(--color-text);
		text-decoration-line: underline;
	}

	/* Index: two-line rows with a thumbnail, for touch and narrow screens */
	.work-cols {
		display: none;
	}

	.work-list {
		list-style: none;
		border-block-start: 1px solid var(--color-border);
	}

	.work-row {
		--bleed: min(0.75rem, var(--page-margin) / 2);
		--thumb: clamp(4rem, 20vw, 5.5rem);

		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: var(--thumb) minmax(0, 1fr) auto;
		grid-template-areas:
			"thumb name year"
			"thumb meta meta";
		column-gap: var(--spacing-md);
		row-gap: 0.125rem;
		padding-block: var(--spacing-md);
		border-block-end: 1px solid var(--color-border);
	}

	/* The hover fill runs slightly past the rules so text never touches its edge */
	.work-row::before {
		content: "";
		position: absolute;
		inset-block: 0;
		inset-inline: calc(-1 * var(--bleed));
		z-index: -1;
		background: var(--color-fill);
		opacity: 0;
		transition: opacity var(--transition-fast);
	}

	.work-row:is(:hover, :has(.work-row__link:focus-visible))::before {
		opacity: 1;
	}

	.work-row__thumb {
		grid-area: thumb;
		align-self: center;
		aspect-ratio: 4 / 3;
	}

	.work-row__num {
		display: none;
	}

	.work-row__name {
		grid-area: name;
		align-self: last baseline;
		min-width: 0;
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		text-wrap: pretty;
		overflow-wrap: anywhere;
	}

	.work-row__link {
		color: inherit;
		text-decoration: none;
	}

	/* One link per row: its hit area covers the whole row */
	.work-row__link::after {
		content: "";
		position: absolute;
		inset-block: 0;
		inset-inline: calc(-1 * var(--bleed));
		z-index: 1;
	}

	.work-row__link:focus-visible {
		outline: none;
	}

	.work-row__link:focus-visible::after {
		outline: 2px solid var(--color-brand);
		outline-offset: -2px;
	}

	/* Visual editing: annotated fields sit above the row link so they stay clickable */
	.work-row [data-emdash-ref] {
		position: relative;
		z-index: 2;
	}

	.work-row__meta {
		grid-area: meta;
		align-self: start;
		min-width: 0;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-muted);
		overflow-wrap: anywhere;
	}

	.work-row__client + .work-row__tags::before {
		content: "·";
		content: "·" / "";
		margin-inline: 0.4em;
	}

	.work-row__year {
		grid-area: year;
		align-self: last baseline;
		min-width: 0;
		text-align: end;
		overflow-wrap: anywhere;
	}

	.work-preview {
		display: none;
	}

	.work-more {
		padding-block-start: var(--spacing-xl);
		font-size: var(--font-size-lg);
	}

	/* Empty states */
	.work-empty__title {
		padding-block-start: var(--spacing-xl);
		border-block-start: 1px solid var(--color-border);
		font-size: var(--font-size-2xl);
		line-height: var(--leading-snug);
		overflow-wrap: anywhere;
	}

	.work-empty__text {
		max-width: 44ch;
		margin-block-start: var(--spacing-sm);
		color: var(--color-text-secondary);
	}

	.work-empty .btn {
		margin-block-start: var(--spacing-xl);
	}

	@media (min-width: 768px) {
		.work-row {
			--thumb: 7rem;

			column-gap: var(--gutter);
			padding-block: 1.125rem;
		}

		.work-row__name {
			font-size: var(--font-size-xl);
		}
	}

	@media (min-width: 1024px) {
		.work-row {
			--thumb: 8rem;
		}
	}

	/* Index: one row per project in columns, beside the preview */
	@media (min-width: 1280px) and (hover: hover) {
		.work-cols,
		.work-row {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-areas: none;
			align-items: baseline;
			column-gap: var(--gutter);
			row-gap: 0;
		}

		.work-cols {
			padding-block-end: var(--spacing-sm);
		}

		.work-row__thumb {
			display: none;
		}

		.work-row__meta {
			display: contents;
		}

		.work-row__client + .work-row__tags::before {
			content: none;
		}

		.work-row :is(.work-row__client, .work-row__tags) {
			font-size: var(--font-size-base);
			color: var(--color-text-secondary);
		}

		:is(.col-num, .col-name, .col-client, .col-tags, .col-year) {
			grid-row: 1;
			align-self: baseline;
		}

		.col-num {
			display: block;
			grid-column: 1;
		}

		.col-name {
			grid-column: 2 / span 4;
		}

		.col-client {
			grid-column: 6 / span 3;
		}

		.col-tags {
			grid-column: 9 / span 3;
		}

		.col-year {
			grid-column: 12;
			text-align: end;
		}
	}

	/*
	 * From 1280px the list gives up its last three columns to a preview of
	 * the hovered or focused project. Each row's preview is a column as tall
	 * as the whole frame with the image stuck inside it, so the image stays
	 * centred in the window as the list scrolls but never leaves the frame.
	 */
	@media (min-width: 1280px) and (hover: hover) {
		.work {
			--rows-width: calc(75% - var(--gutter) / 4);
			--plate-width: calc(
				(min(100vw, var(--frame-width)) - 2 * var(--page-margin) - 3 * var(--gutter)) / 4
			);
			--plate-height: min(var(--plate-width) * 1.25, 100vh - 2 * var(--spacing-xl));

			position: relative;
			min-height: var(--plate-height);
		}

		.work-head,
		.work-ledger {
			max-width: var(--rows-width);
		}

		.work-cols,
		.work-row {
			grid-template-columns: repeat(9, minmax(0, 1fr));
		}

		.col-name {
			grid-column: 2 / span 3;
		}

		.col-client {
			grid-column: 5 / span 2;
		}

		.col-tags {
			grid-column: 7 / span 2;
		}

		.col-year {
			grid-column: 9;
		}

		.work-preview {
			display: block;
			position: absolute;
			inset-block: 0;
			inset-inline-end: var(--page-margin);
			width: calc((100% - 2 * var(--page-margin) - 3 * var(--gutter)) / 4);
			pointer-events: none;
			opacity: 0;
			transition: opacity 200ms var(--ease-out);
		}

		.work-preview__plate {
			position: sticky;
			top: max(var(--spacing-xl), 50vh - var(--plate-height) / 2);
			height: var(--plate-height);
			scale: 0.96;
			transition: scale 450ms var(--ease-out);
		}

		.work-item:is(:hover, :has(.work-row__link:focus-visible)) .work-preview {
			opacity: 1;
		}

		.work-item:is(:hover, :has(.work-row__link:focus-visible)) .work-preview__plate {
			scale: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-preview,
		.work-preview__plate {
			transition: none;
		}

		.work-preview__plate {
			scale: none;
		}
	}

	@media (forced-colors: active) {
		.work-filter a[aria-current="page"] {
			text-decoration-thickness: 2px;
		}
	}
</style>
