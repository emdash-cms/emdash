---
import {
	decodeSlug,
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const {
	entry: project,
	error,
	cacheHint: projectCacheHint,
} = await getEmDashEntry("projects", slug);

if (error) return new Response("Could not load the project", { status: 500 });
if (!project) {
	return Astro.rewrite("/404");
}

// The next project is the next older one, so the links walk the whole
// archive. The range includes this project, so two entries are enough; the
// oldest project gets no next project. Without a date (a draft in preview)
// the next is the newest project.
const publishedAt = project.data.publishedAt;
const olderResult = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	limit: 2,
	...(publishedAt
		? { where: { published_at: { lte: publishedAt.toISOString() } } }
		: {}),
});
if (olderResult.error) {
	return new Response("Could not load related projects", { status: 500 });
}
const { entries: olderProjects, cacheHint: olderCacheHint } = olderResult;
const nextProject = olderProjects.find((p) => p.id !== project.id);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectCacheHint);
	Astro.cache.set(olderCacheHint);
}

function safeExternalUrl(value: string | undefined): string | undefined {
	if (!value) return undefined;
	try {
		const url = new URL(value);
		return url.protocol === "https:" || url.protocol === "http:"
			? url.href
			: undefined;
	} catch {
		return undefined;
	}
}

const projectUrl = safeExternalUrl(project.data.url);
const seo = getSeoMeta(project, {
	siteUrl: Astro.url.origin,
	path: `/work/${slug}`,
	defaultDescription: project.data.summary,
	defaultOgImage: project.data.featured_image?.src,
});

const { client, year, summary } = project.data;
const disciplines = project.data.terms?.tag ?? [];
const websiteLabel = projectUrl
	? new URL(projectUrl).host.replace(/^www\./, "")
	: undefined;
const hasMeta = Boolean(
	client || year || disciplines.length > 0 || projectUrl,
);

const figures = (project.data.gallery ?? []).filter((item) => item.image);

// Figures run full, half, half. A half with no partner goes full width.
function isHalf(index: number): boolean {
	const position = index % 3;
	return position === 2 || (position === 1 && index < figures.length - 1);
}

function pad(n: number): string {
	return String(n).padStart(2, "0");
}

const fullSizes = "(min-width: 1680px) 1600px, (min-width: 768px) 96vw, 150vw";
const halfSizes = "(min-width: 1680px) 1200px, (min-width: 768px) 72vw, 150vw";
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "projects", id: project.data.id, slug }}
>
	<article class="case">
		<header class="case-head frame">
			<a href="/work" class="case-back label arrow-link arrow-link--back">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 12h16M13 5l7 7-7 7" />
				</svg>
				Index
			</a>
			<h1 class="case-title" {...project.edit.title}>
				{project.data.title || "Untitled"}
			</h1>
		</header>

		{
			(summary || hasMeta) && (
				<div class="case-intro frame">
					{summary && (
						<p class="case-lead" {...project.edit.summary}>
							{summary}
						</p>
					)}
					{hasMeta && (
						<dl class="case-meta">
							{client && (
								<div class="case-meta__row">
									<dt class="label">Client</dt>
									<dd {...project.edit.client}>{client}</dd>
								</div>
							)}
							{year && (
								<div class="case-meta__row">
									<dt class="label">Year</dt>
									<dd class="case-meta__year" {...project.edit.year}>
										{year}
									</dd>
								</div>
							)}
							{disciplines.length > 0 && (
								<div class="case-meta__row">
									<dt class="label">
										{disciplines.length === 1 ? "Discipline" : "Disciplines"}
									</dt>
									<dd>
										<ul class="case-meta__tags" role="list">
											{disciplines.map((term) => (
												<li>
													<a href={`/work?tag=${encodeURIComponent(term.slug)}`}>
														{term.label}
													</a>
												</li>
											))}
										</ul>
									</dd>
								</div>
							)}
							{projectUrl && (
								<div class="case-meta__row">
									<dt class="label">Website</dt>
									<dd>
										<a
											href={projectUrl}
											class="case-meta__site"
											target="_blank"
											rel="noopener noreferrer"
											{...project.edit.url}
										>
											{websiteLabel}
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<path d="M7 17 17 7M8 7h9v9" />
											</svg>
											<span class="sr-only">(opens in a new tab)</span>
										</a>
									</dd>
								</div>
							)}
						</dl>
					)}
				</div>
			)
		}

		{
			project.data.featured_image && (
				<div class="case-cover frame">
					<div class="case-cover__media media" {...project.edit.featured_image}>
						<Image
							image={project.data.featured_image}
							sizes="(min-width: 1680px) 1600px, (min-width: 768px) 100vw, 150vw"
							priority
						/>
					</div>
				</div>
			)
		}

		<div class="case-body frame">
			<div class="prose prose-hang" {...project.edit.content}>
				<PortableText value={project.data.content} />
			</div>
		</div>

		{
			figures.length > 0 && (
				<div class="case-gallery frame" {...project.edit.gallery}>
					{figures.map((item, i) => (
						<figure class:list={["case-figure", { "case-figure--half": isHalf(i) }]}>
							<div class="case-figure__media media">
								<Image image={item.image} sizes={isHalf(i) ? halfSizes : fullSizes} />
							</div>
							<figcaption class="label">
								<span class="case-figure__number">Fig. {pad(i + 1)}</span>
								{item.caption && ` — ${item.caption}`}
							</figcaption>
						</figure>
					))}
				</div>
			)
		}
	</article>

	{
		nextProject && (
			<section class="case-next frame" aria-labelledby="case-next-heading">
				<h2 class="label case-next__heading" id="case-next-heading">
					Next project
				</h2>
				<div class="case-next__body media-group">
					<a href={`/work/${nextProject.id}`} class="case-next__link">
						<span class="case-next__title" {...nextProject.edit.title}>
							{nextProject.data.title || "Untitled"}
						</span>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 12h16M13 5l7 7-7 7" />
						</svg>
					</a>
					{nextProject.data.featured_image && (
						<a
							href={`/work/${nextProject.id}`}
							class="case-next__media"
							tabindex="-1"
							aria-hidden="true"
						>
							<div class="case-next__image media" {...nextProject.edit.featured_image}>
								<Image
									image={nextProject.data.featured_image}
									alt=""
									sizes="(min-width: 1680px) 1600px, 100vw"
								/>
							</div>
						</a>
					)}
				</div>
			</section>
		)
	}
</Base>

<style>
	/* Head */
	.case-head {
		padding-block-start: var(--page-head-space);
	}

	.case-back {
		padding-block: 0.375rem;
		font-weight: 400;
		color: var(--color-muted);
		transition:
			color var(--transition-fast),
			text-decoration-color var(--transition-base);
	}

	.case-back:is(:hover, :focus-visible) {
		color: var(--color-text);
	}

	.case-title {
		margin-block-start: var(--spacing-lg);
		font-size: var(--font-size-title);
		line-height: var(--leading-none);
		overflow-wrap: anywhere;
	}

	/* Intro: summary and facts */
	.case-intro {
		display: grid;
		gap: var(--spacing-2xl) var(--gutter);
		margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
	}

	.case-lead {
		max-width: 34ch;
		font-size: var(--font-size-2xl);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
	}

	.case-meta {
		min-width: 0;
		border-block-end: 1px solid var(--color-border);
	}

	.case-meta__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		align-items: baseline;
		gap: var(--gutter);
		padding-block: 0.75rem;
		border-block-start: 1px solid var(--color-border);
	}

	.case-meta dd {
		min-width: 0;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	.case-meta__year {
		font-variant-numeric: tabular-nums;
	}

	.case-meta a {
		display: inline-block;
		padding-block: 0.125rem;
		color: inherit;
		text-decoration-line: underline;
		text-decoration-color: var(--color-border-strong);
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--transition-fast);
	}

	.case-meta a:is(:hover, :focus-visible) {
		text-decoration-color: currentColor;
	}

	.case-meta__tags {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
	}

	.case-meta__tags li:not(:last-child)::after {
		content: ",";
		content: "," / "";
		margin-inline-end: 0.3em;
	}

	.case-meta__site svg {
		display: inline-block;
		width: 0.875em;
		height: 0.875em;
		margin-inline-start: 0.2em;
		vertical-align: -0.05em;
		transition: translate var(--transition-base);
	}

	.case-meta__site:is(:hover, :focus-visible) svg {
		translate: 2px -2px;
	}

	.case-meta__site svg:dir(rtl) {
		scale: -1 1;
	}

	.case-meta__site:is(:hover, :focus-visible) svg:dir(rtl) {
		translate: -2px -2px;
	}

	/* Cover */
	.case-cover {
		margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
	}

	.case-cover__media {
		aspect-ratio: 4 / 5;
	}

	/* Body */
	.case-body {
		margin-block-start: var(--section-gap);
	}

	.case-body:has(> .prose:empty) {
		display: none;
	}

	/* Gallery */
	.case-gallery {
		display: grid;
		gap: var(--spacing-2xl) var(--gutter);
		margin-block-start: var(--section-gap);
	}

	.case-figure {
		min-width: 0;
	}

	.case-figure__media {
		aspect-ratio: 4 / 3;
	}

	.case-figure--half .case-figure__media {
		aspect-ratio: 4 / 5;
	}

	.case-figure figcaption {
		margin-block-start: 0.75rem;
		overflow-wrap: anywhere;
	}

	.case-figure__number {
		color: var(--color-text);
	}

	/* Next project */
	.case-next {
		margin-block-start: var(--section-gap);
	}

	.case-next__heading {
		padding-block-start: var(--spacing-md);
		border-block-start: 1px solid var(--color-border);
	}

	.case-next__link {
		display: block;
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-display);
		color: var(--color-text);
		text-decoration-line: none;
		overflow-wrap: anywhere;
	}

	.case-next__title {
		text-decoration-thickness: max(1px, 0.03em);
		text-underline-offset: 0.12em;
	}

	.case-next__body {
		margin-block-start: var(--spacing-sm);
	}

	.case-next__link svg {
		display: inline-block;
		width: 0.6em;
		height: 0.6em;
		margin-inline-start: 0.12em;
		vertical-align: 0.02em;
		transition: translate var(--transition-base);
	}

	.case-next__body:is(:hover, :has(a:focus-visible)) .case-next__title {
		text-decoration-line: underline;
	}

	.case-next__body:is(:hover, :has(a:focus-visible)) .case-next__link svg {
		translate: 0.08em 0;
	}

	.case-next__link svg:dir(rtl) {
		scale: -1 1;
	}

	.case-next__body:is(:hover, :has(a:focus-visible)) .case-next__link svg:dir(rtl) {
		translate: -0.08em 0;
	}

	/* Padding rather than margin, so the gap above the image is part of the link */
	.case-next__media {
		display: block;
		padding-block-start: var(--spacing-xl);
	}

	.case-next__image {
		aspect-ratio: 16 / 9;
	}

	@media (min-width: 768px) {
		.case-cover__media {
			aspect-ratio: 16 / 9;
		}

		.case-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--spacing-3xl);
		}

		.case-figure {
			grid-column: 1 / -1;
		}

		.case-figure--half {
			grid-column: auto;
		}

		.case-figure__media {
			aspect-ratio: 16 / 9;
		}

		.case-next__image {
			aspect-ratio: 21 / 9;
		}
	}

	@media (min-width: 1024px) {
		.case-intro {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			align-items: start;
		}

		.case-lead {
			grid-column: 1 / span 7;
		}

		.case-meta {
			grid-column: 9 / span 4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.case-meta__site svg,
		.case-next__link svg {
			transition: none;
		}
	}
</style>
