---
import { getEditMeta, getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const {
	entry: page,
	error,
	cacheHint,
} = await getEmDashEntry("pages", "about");
if (error) return new Response("Could not load the page", { status: 500 });
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: "/about",
	defaultDescription: "Learn more about who we are and what we do.",
});
const content = page.data.content;
// In edit mode an empty body carries edit metadata; render it so the
// inline editor has somewhere to start.
const showContent = Boolean(
	content && (content.length > 0 || getEditMeta(content)),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug: "about" }}
>
	<article class="frame about">
		<header class="about__head">
			<h1 class="about__title" {...page.edit.title}>
				{page.data.title}
			</h1>
		</header>

		<div class="prose prose-hang about__body" {...page.edit.content}>
			{
				showContent ? (
					<PortableText value={content} />
				) : (
					<p class="about__empty">Content coming soon.</p>
				)
			}
		</div>
	</article>
</Base>

<style>
	.about {
		padding-block-start: var(--page-head-space);
	}

	.about__head {
		margin-block-end: clamp(2.5rem, 1.5rem + 4vw, 6rem);
	}

	.about__title {
		font-size: var(--font-size-title);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-none);
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.about__body {
		--prose-media-column: 1 / -1;
	}

	/* The opening paragraph is the page's lead. */
	.about__body > :global(p:first-child:not(.about__empty)) {
		max-width: none;
		color: var(--color-text);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
	}

	.about__body > :global(p:first-child + :is(p, ul, ol)) {
		margin-block-start: var(--prose-media);
	}

	.about__empty {
		grid-column: 1 / -1;
		color: var(--color-muted);
	}

	@media (min-width: 1024px) {
		.about__body > :global(p:first-child:not(.about__empty)) {
			grid-column: 1 / 11;
			font-size: var(--font-size-3xl);
			line-height: 1.1;
		}
	}
</style>
