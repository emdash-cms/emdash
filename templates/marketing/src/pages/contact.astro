---
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageContent = page?.data.content;
const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/contact",
			defaultDescription:
				"Questions, a demo, or a building you want us to look at? Talk directly with the Halden team.",
		})
	: null;
---

<Base
	title={seo?.title || "Contact"}
	pageTitle={page?.data.title || "Contact"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page && pageContent ? (
			<div class="page-blocks" {...page.edit.content}>
				<MarketingBlocks value={pageContent} />
			</div>
		) : (
			<section class="container empty-state">
				<h1 class="display empty-state__title">Contact</h1>
				<p class="lead">Add blocks to this page in the admin to get started.</p>
				{Astro.locals.user && (
					<div class="actions">
						<a href="/_emdash/admin" class="btn btn-lg">
							Open admin
						</a>
					</div>
				)}
			</section>
		)
	}
</Base>
