---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type LogosBlock = Extract<PageContentBlock, { _type: "marketing_logos" }>;
type Props = BlockComponentProps<LogosBlock>;

const { value } = Astro.props;
const { anchor_id, headline, logos } = value;
---

<section class="logos section" id={anchor_id || undefined}>
	{headline && <h2 class="container logos__label">{headline}</h2>}
	<div class="marquee" style={`--logo-count: ${Math.max(logos.length, 6)}`}>
		{[false, true].map((duplicate) => (
			<ul class="marquee__group" role="list" aria-hidden={duplicate ? "true" : undefined}>
				{logos.map((logo) => (
					<li>
						{logo.logo ? <Image image={logo.logo} alt={logo.name} sizes="140px" /> : logo.name}
					</li>
				))}
			</ul>
		))}
	</div>
</section>

<style>
	.logos__label {
		margin-block-end: 28px;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 400;
		line-height: var(--leading-normal);
		letter-spacing: normal;
		text-align: center;
		text-wrap: balance;
		color: var(--color-muted);
	}

	.marquee {
		--marquee-gap: clamp(48px, 6vw, 96px);
		display: flex;
		gap: var(--marquee-gap);
		width: min(100%, var(--sheet-max));
		margin-inline: auto;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}

	.marquee__group {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: space-around;
		gap: var(--marquee-gap);
		min-width: 100%;
		height: 64px;
		list-style: none;
		color: var(--color-text-secondary);
	}

	.marquee__group li {
		white-space: nowrap;
	}

	.marquee__group li:nth-child(6n + 1) {
		font: 600 14px / 1 var(--font-body);
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}

	.marquee__group li:nth-child(6n + 2) {
		font: italic 400 28px / 1 var(--font-display);
	}

	.marquee__group li:nth-child(6n + 3) {
		font: 700 22px / 1 var(--font-body);
		letter-spacing: -0.045em;
	}

	.marquee__group li:nth-child(6n + 4) {
		font: 400 27px / 1 var(--font-display);
		letter-spacing: 0.02em;
	}

	.marquee__group li:nth-child(6n + 5) {
		font: 500 22px / 1 var(--font-body);
		letter-spacing: -0.03em;
		text-transform: lowercase;
	}

	.marquee__group li:nth-child(6n + 6) {
		font: 400 13px / 1 var(--font-body);
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}

	.marquee__group :global(img) {
		width: auto;
		max-width: 140px;
		height: 28px;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.72;
	}

	@media (prefers-reduced-motion: no-preference) {
		.marquee__group {
			animation: logos-marquee calc(var(--logo-count, 6) * 8s) linear infinite;
		}

		.marquee__group:dir(rtl) {
			animation-name: logos-marquee-rtl;
		}

		.marquee:is(:hover, :focus-within) .marquee__group {
			animation-play-state: paused;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee {
			display: block;
			padding-inline: var(--gutter);
			mask-image: none;
		}

		.marquee__group {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: 24px;
			height: auto;
		}

		.marquee__group[aria-hidden="true"] {
			display: none;
		}
	}

	@keyframes logos-marquee {
		to {
			translate: calc(-100% - var(--marquee-gap)) 0;
		}
	}

	@keyframes logos-marquee-rtl {
		to {
			translate: calc(100% + var(--marquee-gap)) 0;
		}
	}
</style>
