---
import { sanitizeHref } from "emdash";

interface RawPlan {
	name: string;
	price: string;
	period?: string;
	description?: string;
	// Features are stored as a newline-separated string (Block Kit has no
	// list-of-strings element, so a multiline text input is the closest fit).
	features?: string;
	// CTAs are flattened to sibling fields because Block Kit has no
	// object-group element.
	ctaLabel?: string;
	ctaUrl?: string;
	highlighted?: boolean;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
		plans: RawPlan[];
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, plans: rawPlans } = node;
const headingId = _key ? `${_key}-heading` : undefined;

const plans = rawPlans.map((plan) => {
	const ctaLabel = plan.ctaLabel?.trim();

	return {
		...plan,
		features: (plan.features ?? "")
			.split("\n")
			.map((feature) => feature.trim())
			.filter(Boolean),
		cta: ctaLabel
			? {
					label: ctaLabel,
					url: sanitizeHref(plan.ctaUrl?.trim()),
				}
			: null,
	};
});
---

<section
	class:list={["pricing", "section", { "pricing-with-header": headline }]}
	id={_key}
	aria-labelledby={headline ? headingId : undefined}
>
	<div class="pricing-container">
		{headline && (
			<header class="pricing-header">
				<h2 class="pricing-headline" id={headingId}>{headline}</h2>
				{subheadline && <p class="pricing-subheadline">{subheadline}</p>}
			</header>
		)}
		<div class="pricing-stage">
			<div class="pricing-shell">
				<div class="pricing-grid">
					{plans.map((plan) => (
						<article class:list={["pricing-plan", { "pricing-plan-highlighted": plan.highlighted }]}>
							<div class="pricing-plan-inner">
								<header class="pricing-plan-header">
									<h3 class="pricing-name">{plan.name}</h3>
									<p class="pricing-price">
										<span>{plan.price}</span>
										{plan.period && <span> {plan.period}</span>}
									</p>
									{plan.description && <p class="pricing-description">{plan.description}</p>}
								</header>
								{plan.cta && (
									<div class="pricing-action">
										<a
											href={plan.cta.url}
											class:list={["btn", "pricing-cta", { "btn-primary": plan.highlighted, "pricing-cta-neutral": !plan.highlighted }]}
										>
											{plan.cta.label}
										</a>
									</div>
								)}
								<ul class="pricing-features" role="list">
									{plan.features.map((feature) => (
										<li>
											<svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
												<path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
											<span>{feature}</span>
										</li>
									))}
								</ul>
							</div>
						</article>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.pricing.section {
		position: relative;
		padding-block: clamp(3rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2rem);
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.pricing.section:not(.pricing-with-header) {
		padding-block: var(--spacing-xl) var(--spacing-lg);
	}

	.pricing-container {
		max-width: 64rem;
		margin-inline: auto;
		padding-inline: var(--spacing-lg);
	}

	.pricing-header {
		max-width: 42rem;
		margin-inline: auto;
		text-align: center;
	}

	.pricing-headline {
		font-size: 1.875rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.03em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.pricing-subheadline {
		max-width: 36rem;
		margin: var(--spacing-md) auto 0;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.55;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.pricing-stage {
		position: relative;
		container-type: inline-size;
	}

	.pricing-header + .pricing-stage {
		margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
	}

	.pricing-shell {
		position: relative;
		max-width: 24rem;
		margin-inline: auto;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		box-shadow: var(--shadow-sm);
	}

	.pricing-grid {
		display: grid;
	}

	.pricing-plan {
		min-width: 0;
	}

	.pricing-plan-inner {
		position: relative;
	}

	.pricing-plan-highlighted {
		z-index: 1;
		margin-inline: -0.25rem;
		background: var(--color-surface-raised);
		border: 1px solid transparent;
		border-radius: var(--radius);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--color-text) 10%, transparent),
			var(--shadow);
	}

	.pricing-plan-highlighted .pricing-plan-inner {
		padding-inline: 0.25rem;
	}

	:global(:root.dark) .pricing-plan-highlighted {
		background: var(--color-bg);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .pricing-plan-highlighted {
			background: var(--color-bg);
		}
	}

	.pricing-plan-header {
		padding: var(--spacing-xl);
	}

	.pricing-name {
		font-size: var(--font-size-base);
		font-weight: 500;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.pricing-price {
		display: block;
		margin-block: var(--spacing-sm) 0.125rem;
		font-size: var(--font-size-2xl);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.pricing-description {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.pricing-action {
		padding: var(--spacing-md) var(--spacing-xl);
		border-block: 1px solid var(--color-border);
	}

	.pricing-cta {
		width: 100%;
	}

	.pricing-cta-neutral {
		color: var(--color-bg);
		background: var(--color-text);
	}

	.pricing-cta-neutral:hover {
		background: color-mix(in srgb, var(--color-text) 88%, var(--color-bg));
	}

	.pricing-cta-neutral:active {
		background: color-mix(in srgb, var(--color-text) 78%, var(--color-bg));
	}

	.pricing-features {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: var(--spacing-xl);
		list-style: none;
	}

	.pricing-features li {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-base);
		line-height: 1.5;
	}

	.pricing-features li span {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.check-icon {
		width: 0.75rem;
		height: 0.75rem;
		flex: 0 0 auto;
		color: var(--color-primary);
	}

	@media (min-width: 768px) {
		.pricing-headline {
			font-size: 2.25rem;
			line-height: 1.12;
		}
	}

	@media (min-width: 1024px) {
		.pricing-headline {
			font-size: 3rem;
			line-height: 1;
		}
	}

	@container (min-width: 56rem) {
		.pricing-shell {
			max-width: 100%;
		}

		.pricing-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			row-gap: var(--spacing-lg);
		}

		.pricing-plan-highlighted {
			margin: -0.75rem 0;
		}

		.pricing-plan-highlighted .pricing-plan-inner {
			padding: 0.75rem 0;
		}
	}
</style>
