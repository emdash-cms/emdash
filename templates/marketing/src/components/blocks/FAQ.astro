---
interface Props {
	node: {
		_key?: string;
		headline?: string;
		items: Array<{
			question: string;
			answer: string;
		}>;
	};
}

const { node } = Astro.props;
const { _key, headline, items } = node;
---

<section class="faq section" id={_key}>
	<div class="faq-container container">
		{
			headline && (
				<header class="faq-header">
					<h2 class="faq-headline">{headline}</h2>
				</header>
			)
		}
		<div class="faq-list">
			{
				items.map((item) => (
					<details class="faq-item" name="faq">
						<summary class="faq-question">
							<span>{item.question}</span>
							<svg
								class="faq-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<path d="M6 9l6 6 6-6" />
							</svg>
						</summary>
						<div class="faq-answer">
							<p>{item.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq.section {
		padding-block: var(--spacing-4xl);
		background: color-mix(in srgb, var(--color-bg) 62%, var(--color-surface));
	}

	.faq-container {
		width: calc(100% - 16px);
		max-width: var(--focused-width);
		padding-inline: 0;
	}

	.faq-header {
		max-width: 46rem;
		margin-inline: auto;
		text-align: center;
	}

	.faq-headline {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		line-height: 1.12;
		letter-spacing: -0.035em;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.faq-list {
		display: block;
		width: 100%;
		margin-inline: auto;
		padding-inline: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-border) 34%, transparent),
			var(--shadow-sm);
	}

	.faq-header + .faq-list {
		margin-block-start: var(--spacing-3xl);
	}

	.faq-item {
		border-block-end: 1px dashed var(--color-border);
	}

	.faq-item:last-child {
		border-block-end: 0;
	}

	.faq-question {
		display: flex;
		min-height: 56px;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding-block: var(--spacing-md);
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: 1.45;
		cursor: pointer;
		list-style: none;
		transition: color var(--transition-fast);
	}

	.faq-question > span {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.faq-question:hover,
	.faq-item[open] .faq-question {
		color: var(--color-brand);
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		color: var(--color-muted);
		transition: transform var(--transition-base);
	}

	.faq-item[open] .faq-icon {
		transform: rotate(180deg);
	}

	.faq-answer {
		padding-block-end: var(--spacing-md);
	}

	.faq-answer p {
		max-width: 46rem;
		color: var(--color-muted);
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		overflow-wrap: anywhere;
	}

	@media (max-width: 600px) {
		.faq.section {
			padding-block: var(--spacing-3xl);
		}

		.faq-list {
			padding-inline: var(--spacing-lg);
		}

		.faq-header + .faq-list {
			margin-block-start: var(--spacing-2xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-question,
		.faq-icon {
			transition: none;
		}
	}
</style>
