---
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value, blockKey } = Astro.props;
const { anchor_id, headline, subheadline, items } = value;
const hasIntro = Boolean(headline || subheadline);
---

<section
	id={anchor_id || undefined}
	class:list={["container", "section", "faq", { "faq--with-intro": hasIntro }]}
>
	{
		hasIntro && (
			<div class="faq__intro">
				{headline && <h2 class="section-headline">{headline}</h2>}
				{subheadline && <p class="faq__subheadline">{subheadline}</p>}
			</div>
		)
	}
	<div class="faq__list">
		{
			items.map((item) => (
				<details class="card faq__item" name={`faq-${blockKey}`}>
					<summary class="faq__question">
						<span>{item.question}</span>
						<span class="faq__icon" aria-hidden="true">
							<Icon name="ph:plus" />
						</span>
					</summary>
					<div class="faq__answer">
						{toParagraphs(item.answer).map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</details>
			))
		}
	</div>
</section>

<style>
	.faq {
		display: grid;
		align-items: start;
		gap: clamp(40px, 8vw, 112px);
	}

	.faq--with-intro {
		grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
	}

	.faq__intro {
		position: sticky;
		inset-block-start: 104px;
	}

	.faq__subheadline {
		max-width: 34ch;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.section-headline + .faq__subheadline {
		margin-block-start: 20px;
	}

	.faq__list {
		display: grid;
		gap: 10px;
	}

	.faq__item {
		border-radius: var(--radius-lg);
	}

	.faq__item[open] {
		box-shadow: var(--shadow-card-hover);
	}

	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-block: 18px;
		padding-inline: 24px 18px;
		border-radius: inherit;
		font-size: 16.5px;
		font-weight: 500;
		list-style: none;
		cursor: pointer;
	}

	.faq__question::-webkit-details-marker {
		display: none;
	}

	.faq__icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-sunken);
		color: var(--color-text-secondary);
		font-size: 15px;
	}

	.faq__item[open] .faq__icon {
		rotate: 45deg;
	}

	.faq__answer {
		max-width: 62ch;
		padding-inline: 24px;
		padding-block-end: 24px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.faq__answer p + p {
		margin-block-start: 12px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.faq__icon {
			transition: rotate 220ms var(--ease-out);
		}
	}

	@media (max-width: 960px) {
		.faq--with-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.faq__intro {
			position: static;
		}
	}
</style>
