---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type TestimonialsBlock = Extract<PageContentBlock, { _type: "marketing_testimonials" }>;
type Props = BlockComponentProps<TestimonialsBlock>;

const WHITESPACE = /\s+/;

function getInitials(name: string) {
	const letters = name
		.trim()
		.split(WHITESPACE)
		.map((word) => [...word][0] ?? "");
	const ends = letters.length > 1 ? [letters[0], letters.at(-1)] : letters;
	return ends.join("").toUpperCase();
}

const { value } = Astro.props;
const { anchor_id, headline } = value;
const [featured, ...others] = value.testimonials.map((testimonial) => ({
	...testimonial,
	initials: getInitials(testimonial.author),
	attribution: [testimonial.role, testimonial.company].filter(Boolean).join(", "),
}));
---

<section id={anchor_id || undefined} class="container section">
	{headline && <h2 class="eyebrow testimonials__label">{headline}</h2>}
	{
		featured && (
			<figure class="testimonials__featured">
				<span class="testimonials__mark" aria-hidden="true">“</span>
				<blockquote class="display testimonials__featured-quote">
					<p>{featured.quote}</p>
				</blockquote>
				<figcaption class="testimonials__who">
					{featured.avatar ? (
						<Image
							image={featured.avatar}
							alt=""
							width={44}
							height={44}
							class="testimonials__avatar"
						/>
					) : (
						<span class="avatar" aria-hidden="true">
							{featured.initials}
						</span>
					)}
					<span>
						{featured.author}
						{featured.attribution && " "}
						{featured.attribution && (
							<span class="testimonials__role">{featured.attribution}</span>
						)}
					</span>
				</figcaption>
			</figure>
		)
	}
	{
		others.length > 0 && (
			<div class="testimonials__grid">
				{others.map((testimonial) => (
					<figure class="card testimonials__card">
						<blockquote class="testimonials__quote">
							<p>{testimonial.quote}</p>
						</blockquote>
						<figcaption class="testimonials__who">
							{testimonial.avatar ? (
								<Image
									image={testimonial.avatar}
									alt=""
									width={44}
									height={44}
									class="testimonials__avatar"
								/>
							) : (
								<span class="avatar" aria-hidden="true">
									{testimonial.initials}
								</span>
							)}
							<span>
								{testimonial.author}
								{testimonial.attribution && " "}
								{testimonial.attribution && (
									<span class="testimonials__role">
										{testimonial.attribution}
									</span>
								)}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		)
	}
</section>

<style>
	.testimonials__label {
		display: flex;
		justify-content: center;
		margin-block-end: 24px;
		line-height: var(--leading-normal);
		letter-spacing: normal;
	}

	.testimonials__featured {
		max-width: 960px;
		margin-inline: auto;
		text-align: center;
	}

	.testimonials__mark {
		display: block;
		height: 0.5em;
		font-family: var(--font-display);
		font-size: 120px;
		line-height: 1;
		color: var(--color-accent);
	}

	.testimonials__featured-quote {
		font-size: clamp(30px, 3.5vw, 48px);
		line-height: 1.16;
		letter-spacing: -0.012em;
	}

	.testimonials__who {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-block-start: 32px;
		font-size: 15px;
		font-weight: 500;
		text-align: start;
	}

	.testimonials__who :global(.testimonials__avatar) {
		flex: none;
		width: 44px;
		max-width: none;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
	}

	.testimonials__role {
		display: block;
		font-size: 14px;
		font-weight: 400;
		color: var(--color-muted);
	}

	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 16px;
		margin-block-start: clamp(56px, 7vw, 96px);
	}

	.testimonials__card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 32px;
	}

	.testimonials__card .testimonials__who {
		margin-block-start: 28px;
	}

	.testimonials__quote {
		font-size: 17px;
		line-height: 1.6;
		text-wrap: pretty;
		quotes: "\201C" "\201D";
	}

	.testimonials__quote p::before {
		content: open-quote;
	}

	.testimonials__quote p::after {
		content: close-quote;
	}
</style>
