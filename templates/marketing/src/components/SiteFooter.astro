---
import { sanitizeHref } from "emdash";

interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
}

interface FooterColumn {
	heading: string;
	menu: {
		items: MenuItem[];
	};
}

interface SiteLogo {
	url: string;
	alt?: string | null;
}

interface Props {
	siteTitle: string;
	siteLogo?: SiteLogo | null;
	tagline: string;
	footerColumns: FooterColumn[];
}

const { siteTitle, siteLogo, tagline, footerColumns: rawFooterColumns } = Astro.props;
const currentYear = new Date().getFullYear();
const EXTERNAL_URL_REGEX = /^https?:\/\//i;

function isExternalUrl(url?: string | null) {
	return typeof url === "string" && EXTERNAL_URL_REGEX.test(url);
}

function getTarget(item: MenuItem) {
	return item.target || (isExternalUrl(item.url) ? "_blank" : undefined);
}

function getRel(item: MenuItem) {
	return getTarget(item) === "_blank" ? "noreferrer" : undefined;
}

const footerColumns = rawFooterColumns
	.map((column) => ({
		...column,
		menu: {
			items: column.menu.items.map((item) => ({
				...item,
				url: sanitizeHref(item.url?.trim()),
			})),
		},
	}))
	.filter((column) => column.menu.items.length > 0);
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" class="footer-logo" aria-label={`${siteTitle} home`}>
					{siteLogo ? (
						<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="footer-logo-img" loading="lazy" />
					) : (
						<span class="footer-logo-text">{siteTitle}</span>
					)}
				</a>
				<p class="footer-tagline">{tagline}</p>
			</div>

			<nav class="footer-links" aria-label="Footer navigation">
				{footerColumns.map((column) => (
					<div class="footer-col">
						<h4>{column.heading}</h4>
						{column.menu.items.map((item) => (
							<a
								href={item.url}
								target={getTarget(item)}
								rel={getRel(item)}
							>
								<span>{item.label}</span>
							</a>
						))}
					</div>
				))}
			</nav>
		</div>

		<div class="footer-bottom">
			<div class="footer-legal">
				<p>&copy; {currentYear} {siteTitle}.</p>
				<p class="footer-powered">Powered by <a href="https://emdashcms.com">EmDash</a></p>
			</div>

			<div class="footer-actions">
				<div class="theme-switcher" aria-label="Theme selector">
					<button type="button" class="theme-btn" data-theme="light" aria-label="Light mode" aria-pressed="false">Light</button>
					<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark mode" aria-pressed="false">Dark</button>
					<button type="button" class="theme-btn" data-theme="system" aria-label="System theme" aria-pressed="false">System</button>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	.footer-shell {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-5xl) var(--spacing-lg) 0;
	}

	.footer-top {
		display: grid;
		gap: var(--spacing-4xl);
	}

	.footer-brand {
		max-width: 20rem;
	}

	.footer-logo {
		display: inline-flex;
		width: fit-content;
		max-width: 100%;
		align-items: center;
		color: var(--color-text);
		font-size: var(--font-size-xl);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.footer-logo-text {
		overflow-wrap: anywhere;
	}
	.footer-logo-img {
		height: 30px;
		width: auto;
	}

	.footer-tagline {
		max-width: 18rem;
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		line-height: 1.6;
		color: var(--color-muted);
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-xl) var(--spacing-2xl);
	}

	.footer-col h4 {
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1.35;
		color: var(--color-text);
	}

	.footer-col a {
		display: block;
		padding: 0.25rem 0;
		font-size: var(--font-size-sm);
		line-height: 1.55;
		color: var(--color-muted);
		transition: color var(--transition-fast);
	}

	.footer-col a:hover {
		color: var(--color-primary);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-4xl);
		padding: var(--spacing-lg) 0;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		border-top: 1px solid var(--color-border);
	}

	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem var(--spacing-md);
	}

	.footer-powered a {
		color: var(--color-text);
		font-weight: 500;
	}

	.footer-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-md);
	}

	.theme-switcher {
		display: flex;
		gap: 2px;
		padding: 3px;
		background: var(--button-secondary-bg);
		border-radius: calc(var(--button-radius) + 4px);
	}

	.theme-btn {
		padding: 6px 10px;
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1.3;
		background: transparent;
		border: 0;
		border-radius: var(--button-radius);
		cursor: pointer;
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.theme-btn:hover,
	.theme-btn.active {
		color: var(--color-text);
		background: var(--color-surface);
	}

	.theme-btn:active {
		transform: scale(0.98);
	}

	@media (min-width: 768px) {
		.footer-top {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		}

		.footer-links {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.footer-shell {
			padding-top: var(--spacing-4xl);
		}

		.footer-bottom {
			align-items: flex-start;
		}

		.footer-actions {
			order: -1;
			width: 100%;
			justify-content: space-between;
		}

		.footer-legal {
			flex-direction: column;
		}
	}

	@media (max-width: 480px) {
		.footer-links {
			grid-template-columns: 1fr;
		}

		.footer-actions {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-btn {
			transition: none;
		}

		.theme-btn:active {
			transform: none;
		}
	}
</style>
