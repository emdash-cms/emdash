		},
		{
			"from": "awaiting_feedback",
			"event": "reject",
			"to": "working",
			"action": "investigate.revise",
			"note": "retry with reporter feedback"
		},
		{
			"from": "awaiting_feedback",
			"event": "retry",
			"to": "working",
			"action": "investigate.repro"
		},
		{
			"from": "awaiting_feedback",
			"event": "take_over",
			"to": "human_owned"
		},
		{
			"from": "in_review",
			"event": "pr.opened",
			"to": "in_review",
			"note": "idempotent; sets review sub-state"
		},
		{
			"from": "in_review",
			"event": "pr.approved",
			"to": "in_review",
			"note": "review sub-state only"
		},
		{
			"from": "in_review",
			"event": "pr.changes_requested",
