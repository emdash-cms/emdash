{
	"name": "@emdash-cms/do-render-demo-site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro build && wrangler dev -c wrangler.front.jsonc -c dist/server/wrangler.json",
		"build": "astro build",
		"deploy": "astro build && wrangler deploy && wrangler deploy --config wrangler.front.jsonc",
		"typecheck": "astro check",
		"cf-typegen": "wrangler types --include-runtime=false -c wrangler.jsonc -c wrangler.front.jsonc"
	},
	"dependencies": {
		"@astrojs/cloudflare": "catalog:",
		"@astrojs/react": "catalog:",
		"@emdash-cms/cloudflare": "workspace:*",
		"@emdash-cms/plugin-forms": "workspace:*",
		"@emdash-cms/plugin-cli": "workspace:*",
		"astro": "catalog:",
		"emdash": "workspace:*",
		"kysely": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@astrojs/check": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"wrangler": "catalog:"
	}
}
